# Copia este archivo a ".env.local" y rellena con las claves de tu proyecto
# de Supabase (Project Settings → API).

NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anon-publica

# OBLIGATORIA: la llave maestra que usa solo el servidor (Supabase → Project Settings → API →
# "service_role"). NUNCA la pongas en una variable que empiece por NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# GoHighLevel (opcional): también se rellenan desde Configuración → Conexiones.
# Si lo haces allí, estas tres ya no hacen falta en el hosting.
GHL_API_KEY=pit-tu-private-integration-token
GHL_LOCATION_ID=tu-location-id
GHL_CALENDAR_ID=tu-calendar-id
